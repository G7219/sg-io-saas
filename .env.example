# ==================== SERVER ====================
NODE_ENV=production
PORT=3000

# ==================== DATABASE ====================
DATABASE_URL="mysql://sg_io_user:${MYSQL_PASSWORD}@localhost:3306/sg_io"
MYSQL_ROOT_PASSWORD=your_strong_password_here
MYSQL_DATABASE=sg_io
MYSQL_USER=sg_io_user
MYSQL_PASSWORD=your_strong_password_here

# ==================== JWT ====================
JWT_SECRET=generate_with_node_-e_crypto_randomBytes_32
JWT_REFRESH_SECRET=generate_with_node_-e_crypto_randomBytes_32
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ==================== APIS ====================
GEMINI_API_KEY=your_gemini_key
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_key
FLUTTERWAVE_SECRET_KEY=your_key
FLUTTERWAVE_PUBLIC_KEY=your_key
MPESA_API_KEY=your_key
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""

# ==================== DOMAINS ====================
PRIMARY_DOMAIN=sg.io
ALLOWED_ORIGINS=https://sg.io,https://www.sg.io,https://*.sg.io

# ==================== FEATURES ====================
ENABLE_MOBILE_MONEY=true
ENABLE_CARD_PAYMENTS=true
ENABLE_CRYPTO=false

# ==================== SUPPORT ====================
SUPPORT_EMAIL=support@sg.io
SUPPORT_PHONE=+255799183830-support@sg.io
COMPANY_NAME=SG.IO