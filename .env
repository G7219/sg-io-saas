# ============================================================================
# 7. FILE STORAGE (AWS S3)
# ============================================================================

AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_S3_BUCKET="sg-io-files"
AWS_S3_REGION="us-east-1"
AWS_S3_URL="https://sg-io-files.s3.us-east-1.amazonaws.com"

# Local Upload (If not using S3)
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE=5242880

# ============================================================================
# 8. LOGGING & MONITORING
# ============================================================================

LOG_LEVEL="info"
LOG_FORMAT="json"

# Sentry (Error Tracking)
SENTRY_DSN="https://your-key@sentry.io/your-project"
SENTRY_ENVIRONMENT="production"

# ============================================================================
# 9. ANALYTICS
# ============================================================================

GOOGLE_ANALYTICS_ID="G-07ZTY6SSJKD"
MIXPANEL_TOKEN="your_mixpanel_token"

# ============================================================================
# 10. FEATURE FLAGS
# ============================================================================

ENABLE_AI_FEATURES="true"
ENABLE_B2B="false"
ENABLE_AFFILIATE="false"
ENABLE_MULTI_VENDOR="false"
ENABLE_SUBSCRIPTION="true"
ENABLE_INVENTORY_TRACKING="true"

# ============================================================================
# 11. RATE LIMITING
# ============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================================
# 12. CACHE (REDIS)
# ============================================================================

REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
CACHE_TTL=3600

# ============================================================================
# 13. BACKUP SETTINGS
# ============================================================================

BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET="sg-io-backups"
BACKUP_S3_PATH="database/"

# ============================================================================
# 14. SECURITY SETTINGS
# ============================================================================

SSL_ENABLED="false"
SSL_CERT_PATH="/etc/ssl/certs/cert.pem"
SSL_KEY_PATH="/etc/ssl/private/key.pem"
ENABLE_SECURITY_HEADERS="true"
ENABLE_HELMET="true"

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_NUMBERS="true"
PASSWORD_REQUIRE_SPECIAL_CHARS="true"

# 2FA
ENABLE_2FA="true"
2FA_WINDOW_SIZE=30
2FA_BACKUP_CODES_COUNT=10

# ============================================================================
# 15. EXTERNAL SERVICES
# ============================================================================

# Twilio (SMS)
TWILIO_ACCOUNT_SID="your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Firebase (Notifications)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="your_private_key"
FIREBASE_CLIENT_EMAIL="your_client_email"

# ============================================================================
# 16. PRISMA CONFIGURATION
# ============================================================================

PRISMA_SKIP_ENGINE_CHECK="true"
PRISMA_DEBUG="false"
PRISMA_BINARY_TARGET="native"

# ============================================================================
# 17. BUSINESS CONFIGURATION
# ============================================================================

COMPANY_NAME="SG.IO"
SUPPORT_EMAIL="support@sg.io"
SUPPORT_PHONE="+1-800-123-4567"
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="UTC"

# ============================================================================
# 18. WEBHOOK SETTINGS
# ============================================================================

STRIPE_WEBHOOK_URL="https://sg.io/webhooks/stripe"
STRIPE_WEBHOOK_VERSION="2022-11-15"

# ============================================================================
# 19. PRODUCTION SETTINGS
# ============================================================================

DEPLOYMENT_ENVIRONMENT="development"
DEPLOYMENT_REGION="us-east-1"
HEALTH_CHECK_INTERVAL=30000

# ============================================================================
# 20. AI USAGE LIMITS (per plan)
# ============================================================================

# Free Plan
FREE_AI_MESSAGES_LIMIT=10000
FREE_AI_IMAGES_LIMIT=100

# Lite Plan
LITE_AI_MESSAGES_LIMIT=50000
LITE_AI_IMAGES_LIMIT=500

# Rise Plan
RISE_AI_MESSAGES_LIMIT=500000
RISE_AI_IMAGES_LIMIT=5000

# Elite Plan
ELITE_AI_MESSAGES_LIMIT=9999999
ELITE_AI_IMAGES_LIMIT=99999

# ============================================================================
# 21. PAYMENT SETTINGS
# ============================================================================

TRANSACTION_FEE_PERCENTAGE=2.9
TRANSACTION_FEE_FIXED=0.30
MIN_TRANSACTION_AMOUNT=1.00
MAX_TRANSACTION_AMOUNT=100000.00

# ============================================================================
# 22. NOTIFICATION SETTINGS
# ============================================================================

ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_PUSH_NOTIFICATIONS="false"

# ============================================================================
# 23. DATA RETENTION
# ============================================================================

ANALYTICS_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
TRASH_RETENTION_DAYS=30

# ============================================================================
# IMPORTANT: BEFORE USING IN PRODUCTION
# ============================================================================
# 
# 1. Change all placeholder values marked with "YOUR_"
# 2. Generate strong JWT_SECRET: openssl rand -base64 32
# 3. Create database and update DATABASE_URL
# 4. Get API keys from each service:
#    - Stripe: https://dashboard.stripe.com
#    - Gemini: https://makersuite.google.com
#    - Claude: https://console.anthropic.com
#    - Flutterwave: https://dashboard.flutterwave.com
# 5. Add .env to .gitignore (IMPORTANT!)
# 6. Use different .env for production
# 7. Keep backups of all API keys
#
# ============================================================================