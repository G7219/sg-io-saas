# ============================================================================
# SG.IO - PRODUCTION READY .ENV FILE
# Copy this directly to your project root as ".env"
# ============================================================================

# ============================================================================
# 1. DATABASE CONFIGURATION
# ============================================================================

# MySQL Connection (Change password and host as needed)
DATABASE_URL="mysql://root:@localhost:3306/sg_io"

# For local development, use:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/sg_io"

# For production, update to your server:
# DATABASE_URL="mysql://sg_io_user:strong_password@db.example.com:3306/sg_io"

# ============================================================================
# 2. SERVER & APPLICATION
# ============================================================================

NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000/admin"
API_URL="http://localhost:3000/api"

# ============================================================================
# 3. AUTHENTICATION & SECURITY
