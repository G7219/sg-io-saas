// Prisma Schema - SG.IO Multi-Tenant SaaS Platform
// Complete database with ALL features: locations, products, orders, payments, 
// shipping, analytics, reviews, ratings, feature gating, subscriptions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SUBSCRIPTION & FEATURE GATING (NEW)
// ============================================================

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique // FREE, LITE, RISE, ELITE
  displayName String
  description String? @db.LongText

  // Pricing
  price_usd Float @default(0)
  price_kes Float @default(0)
  price_eur Float @default(0)

  // AI Limits
  ai_messages_monthly Int   @default(10000)
  overage_cost_per_1k Float @default(0)

  // Limits
  max_users    Int @default(1)
  max_products Int @default(100)
  max_orders   Int @default(1000)

  // Features
  features PlanFeature[]
  tenants  Tenant[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Feature {
  id          String  @id @default(cuid())
  key         String  @unique // e.g., "maps_integration"
  name        String
  description String? @db.LongText
  minTier     String // FREE, LITE, RISE, ELITE
  category    String // branding, maps, sync, analytics, etc

  plans PlanFeature[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PlanFeature {
  id      String           @id @default(cuid())
  plan_id String
  plan    SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  feature_id String
  feature    Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, feature_id])
  @@index([plan_id])
  @@index([feature_id])
}

// ============================================================
// TENANT & SUBSCRIPTION MANAGEMENT (UPDATED)
// ============================================================

model Tenant {
  id                      String    @id @default(cuid())
  business_name           String    @db.VarChar(255)
  subdomain               String    @unique @db.VarChar(100)
  owner_email             String    @unique @db.VarChar(255)
  tier                    String    @default("lite") // lite, rise, elite
  status                  String    @default("trial") // trial, active, suspended, expired
  is_launched             Boolean   @default(false)
  subscription_expires_at DateTime?
  selected_niche          String?   @db.VarChar(50) // pharmacy, church, salon, real-estate, b2b, boutique, restaurant
  primary_color           String?   @default("#667eea")
  business_location       String?   @db.VarChar(255)
  phone_number            String?   @db.VarChar(20)
  website_url             String?   @db.VarChar(255)

  // Brand Configuration (FIXED - NEW FIELDS)
  logo_url        String? @db.LongText // Logo image URL
  branding_config Json? // JSON: { primary_color, secondary_color, logo_url }

  // Main branch (for aggregated dashboard)
  main_branch_id String?

  // API usage tracking
  api_requests_this_month Int @default(0)

  // Subscription
  subscription_plan_id String?
  subscription_plan    SubscriptionPlan? @relation(fields: [subscription_plan_id], references: [id])

  // AI Usage
  ai_messages_used      Int       @default(0)
  ai_messages_limit     Int       @default(10000) // Monthly limit
  ai_message_reset_date DateTime?

  // Relationships
  settings            TenantSettings?
  merchant_account    MerchantAccount?
  locations           Location[]
  products            Product[]
  orders              Order[]
  payment_logs        PaymentLog[]
  payment_methods     PaymentMethod[]
  audit_logs          AuditLog[]
  security_incidents  SecurityIncident[]
  b2b_discounts       B2BDiscount[]
  shipping_configs    ShippingConfig[]
  reviews             Review[]
  ratings             Rating[]
  weekly_analytics    WeeklyAnalytics[]
  social_media_config SocialMediaConfig?
  users               User[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([subdomain])
  @@index([owner_email])
  @@index([tier])
  @@index([status])
}

model TenantSettings {
  id                 String  @id @default(cuid())
  tenant_id          String  @unique
  primary_color      String  @default("#667eea")
  secondary_color    String  @default("#667eea")
  custom_brand_name  String? @db.VarChar(255)
  opening_hours      String? @db.VarChar(100)
  closing_hours      String? @db.VarChar(100)
  contact_email      String? @db.VarChar(255)
  contact_phone      String? @db.VarChar(20)
  currency           String  @default("USD")
  payment_methods    String? @db.LongText // JSON
  shipping_providers String? @db.LongText // JSON

  // Brand Configuration (FIXED - NEW FIELDS)
  branding_config String? @db.LongText // JSON: { primary_color, secondary_color, logo_url }
  logo_url        String? @db.LongText

  // Features (per subscription tier)
  maps_enabled    Boolean @default(false)
  reviews_enabled Boolean @default(false)
  api_enabled     Boolean @default(false)
  white_label     Boolean @default(false)

  // Settings
  theme    String? @default("light")
  language String? @default("en")
  timezone String? @default("UTC")

  // --- Direct Settlement Payment System ---
  mobile_money_network String? @db.VarChar(50) // Example: M-Pesa, MTN
  mobile_money_number  String? @db.VarChar(50) // Till Number or Phone Number

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
}

// ============================================================
// USER - Team members (NEW)
// ============================================================

model User {
  id        String @id @default(cuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  email         String
  password_hash String
  first_name    String?
  last_name     String?
  role          String  @default("staff") // owner, admin, staff

  is_active  Boolean   @default(true)
  last_login DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, email])
  @@index([tenant_id])
}

// ============================================================
// MERCHANT ACCOUNT
// ============================================================

model MerchantAccount {
  id                  String    @id @default(cuid())
  tenant_id           String    @unique
  dashboard_user      String    @unique @db.VarChar(255)
  dashboard_pass_hash String    @db.VarChar(255) // BCRYPT
  login_attempts      Int       @default(0)
  last_login          DateTime?
  is_locked           Boolean   @default(false)

  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([dashboard_user])
}

// ============================================================
// LOCATIONS/BRANCHES
// ============================================================

model Location {
  id             String  @id @default(cuid())
  tenant_id      String
  name           String  @db.VarChar(255) // "Main Store", "Branch 2"
  slug           String ? @db.VarChar(100) // URL slug
  address        String  @db.VarChar(500)
  city           String  @db.VarChar(100)
  country        String  @db.VarChar(100)
  latitude       Float?
  longitude      Float?
  phone_number   String? @db.VarChar(20)
  email          String? @db.VarChar(255)
  opening_hours  String? @db.VarChar(100)
  closing_hours  String? @db.VarChar(100)
  is_active      Boolean @default(true)
  is_main_branch Boolean @default(false)

  // Social media branding
  instagram_handle String? @db.VarChar(100)
  facebook_page    String? @db.VarChar(100)
  tiktok_handle    String? @db.VarChar(100)
  twitter_handle   String? @db.VarChar(100)

  // Relationships
  tenant           Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  inventory        Inventory[]
  shipping_from    ShippingConfig[]
  orders           Order[]
  reviews          Review[]
  ratings          Rating[]
  weekly_analytics WeeklyAnalytics[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([is_main_branch])
  @@index([is_active])
}

// ============================================================
// INVENTORY & PRODUCTS (UPDATED)
// ============================================================

model Product {
  id          String  @id @default(cuid())
  tenant_id   String
  name        String  @db.VarChar(255)
  price       Float
  description String? @db.LongText
  category    String? @db.VarChar(100)
  image_url   String? @db.LongText
  niche       String? @db.VarChar(50)
  is_active   Boolean @default(true)

  // Images (FIXED - NEW FIELDS)
  productImage  String? @db.LongText // Main product image URL
  product_image String? @db.LongText // Alias for compatibility
  images        String? @db.LongText // JSON array of all images

  // B2B specific
  wholesale_price  Float?
  b2b_min_quantity Int    @default(1)

  // Relationships
  tenant      Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  order_items OrderItem[]

  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  ProductSEO ProductSEO?

  @@index([tenant_id])
  @@index([category])
  @@index([is_active])
}

model Inventory {
  id            String @id @default(cuid())
  location_id   String
  product_id    String
  quantity      Int    @default(0)
  reorder_level Int    @default(10)

  location   Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([location_id, product_id])
  @@index([location_id])
  @@index([product_id])
}

// ============================================================
// ORDERS & ORDER ITEMS
// ============================================================

model Order {
  id             String  @id @default(cuid())
  tenant_id      String
  location_id    String
  order_number   String  @unique @db.VarChar(50)
  customer_email String  @db.VarChar(255)
  customer_phone String? @db.VarChar(20)
  customer_name  String? @db.VarChar(255)
  amount         Float
  currency       String  @default("USD")
  status         String  @default("pending")

  // Shipping
  shipping_address   String?   @db.LongText
  shipping_method    String?   @db.VarChar(100)
  tracking_number    String?   @db.VarChar(255)
  estimated_delivery DateTime?

  // B2B
  is_b2b               Boolean @default(false)
  b2b_discount_applied Float   @default(0)

  // Relationships
  tenant            Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [location_id], references: [id])
  items             OrderItem[]
  payment_log       PaymentLog?
  shipping_tracking ShippingTracking?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([location_id])
  @@index([customer_email])
  @@index([status])
  @@index([is_b2b])
  @@index([created_at])
}

model OrderItem {
  id         String @id @default(cuid())
  order_id   String
  product_id String
  quantity   Int
  unit_price Float

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}

// ============================================================
// PAYMENT MANAGEMENT
// ============================================================

model PaymentMethod {
  id          String  @id @default(cuid())
  tenant_id   String
  method_type String  @db.VarChar(50)
  provider_id String? @db.VarChar(255)
  is_primary  Boolean @default(false)
  is_active   Boolean @default(true)

  // Encrypted credentials
  api_key     String? @db.VarChar(500)
  api_secret  String? @db.VarChar(500)
  merchant_id String? @db.VarChar(255)

  // Provider specific
  webhook_secret String? @db.VarChar(500)
  public_key     String? @db.LongText

  tenant   Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  payments PaymentLog[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, method_type])
  @@index([tenant_id])
  @@index([is_active])
}

model PaymentLog {
  id                String  @id @default(cuid())
  tenant_id         String
  order_id          String? @unique
  payment_method_id String

  amount   Float
  currency String @default("USD")
  status   String @default("pending")

  provider                String  @db.VarChar(50)
  provider_transaction_id String? @db.VarChar(255)
  checkout_url            String? @db.LongText

  // Location add-on payment
  is_location_payment  Boolean @default(false)
  additional_locations Int     @default(0)
  location_cost_per    Float   @default(10)

  // Refund info
  refund_reason String?   @db.VarChar(255)
  refund_date   DateTime?
  refund_amount Float?

  // Metadata
  metadata String? @db.LongText

  tenant         Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  order          Order?        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  payment_method PaymentMethod @relation(fields: [payment_method_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([order_id])
  @@index([status])
  @@index([provider])
  @@index([is_location_payment])
  @@index([created_at])
}

// ============================================================
// SHIPPING & DELIVERY
// ============================================================

model ShippingConfig {
  id                  String  @id @default(cuid())
  tenant_id           String
  location_id         String
  provider            String  @db.VarChar(100)
  is_enabled          Boolean @default(true)
  base_cost           Float   @default(0)
  per_km_cost         Float   @default(0.5)
  free_shipping_above Float?

  // API credentials
  provider_api_key    String? @db.VarChar(500)
  provider_api_secret String? @db.VarChar(500)

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, location_id, provider])
  @@index([tenant_id])
  @@index([location_id])
}

model ShippingTracking {
  id                 String    @id @default(cuid())
  order_id           String    @unique
  tracking_number    String    @unique @db.VarChar(255)
  provider           String    @db.VarChar(100)
  status             String    @default("pending")
  current_location   String?   @db.VarChar(255)
  last_update        DateTime?
  estimated_delivery DateTime?

  tracking_data   String?   @db.LongText
  proof_photo_url String?   @db.LongText
  signed_by       String?   @db.VarChar(255)
  delivered_at    DateTime?

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([order_id])
  @@index([tracking_number])
  @@index([status])
}

// ============================================================
// WEEKLY ANALYTICS (Aggregated Dashboard)
// ============================================================

model WeeklyAnalytics {
  id          String   @id @default(cuid())
  tenant_id   String
  location_id String
  week_start  DateTime
  week_end    DateTime

  total_orders     Int   @default(0)
  total_revenue    Float @default(0)
  total_items_sold Int   @default(0)
  avg_order_value  Float @default(0)

  completed_orders Int @default(0)
  pending_orders   Int @default(0)
  cancelled_orders Int @default(0)

  unique_customers Int @default(0)
  repeat_customers Int @default(0)
  new_customers    Int @default(0)

  b2b_orders  Int   @default(0)
  b2b_revenue Float @default(0)

  discounts_given Float @default(0)
  discount_count  Int   @default(0)

  top_products    String? @db.LongText
  daily_breakdown String? @db.LongText

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, location_id, week_start])
  @@index([tenant_id])
  @@index([location_id])
  @@index([week_start])
}

// ============================================================
// REVIEWS & RATINGS
// ============================================================

model Review {
  id               String  @id @default(cuid())
  tenant_id        String
  location_id      String
  customer_name    String  @db.VarChar(255)
  customer_email   String  @db.VarChar(255)
  rating           Int     @default(5)
  title            String? @db.VarChar(255)
  content          String  @db.LongText
  source           String  @default("website")
  google_review_id String? @db.VarChar(255)

  is_verified_purchase Boolean @default(false)
  is_approved          Boolean @default(true)

  admin_response     String?   @db.LongText
  admin_responded_at DateTime?

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([location_id])
  @@index([source])
  @@index([rating])
  @@index([created_at])
}

model Rating {
  id          String @id @default(cuid())
  tenant_id   String
  location_id String

  google_rating           Float? @default(0)
  google_review_count     Int    @default(0)
  facebook_rating         Float?
  facebook_review_count   Int    @default(0)
  trustpilot_rating       Float?
  trustpilot_review_count Int    @default(0)
  website_rating          Float  @default(0)
  website_review_count    Int    @default(0)
  overall_rating          Float  @default(0)

  last_google_sync   DateTime?
  last_facebook_sync DateTime?

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, location_id])
  @@index([tenant_id])
  @@index([location_id])
}

// ============================================================
// SOCIAL MEDIA BRANDING
// ============================================================

model SocialMediaConfig {
  id                    String  @id @default(cuid())
  tenant_id             String  @unique
  instagram_handle      String? @db.VarChar(100)
  instagram_api_key     String? @db.VarChar(500)
  instagram_feed_count  Int     @default(0)
  facebook_page_id      String? @db.VarChar(100)
  facebook_api_key      String? @db.VarChar(500)
  facebook_pixel_id     String? @db.VarChar(100)
  tiktok_handle         String? @db.VarChar(100)
  twitter_handle        String? @db.VarChar(100)
  linkedin_page         String? @db.VarChar(255)
  youtube_channel       String? @db.VarChar(255)
  brand_primary_color   String? @db.VarChar(10)
  brand_secondary_color String? @db.VarChar(10)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
}

// ============================================================
// B2B DISCOUNTS
// ============================================================

model B2BDiscount {
  id                  String    @id @default(cuid())
  location_id         String
  product_id          String
  tenant_id           String?
  customer_email      String ?   @db.VarChar(255)
  customer_name       String?   @db.VarChar(255)
  customer_company    String?   @db.VarChar(255)
  status              String    @default("pending")
  requested_discount  Float     @default(0)
  approved_discount   Float?
  min_order_value     Float     @default(0)
  admin_notes         String?   @db.LongText
  customer_message    String?   @db.LongText
  is_volume_based     Boolean   @default(false)
  min_quantity        Int?
  discount_percentage Float     @default(0)
  discount_amount Float? @default(0)
  is_active Boolean @default(true)
  valid_from          DateTime?
  valid_until         DateTime?

  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@index([customer_email])
}

// ============================================================
// AUDIT & SECURITY
// ============================================================

model AuditLog {
  id          String  @id @default(cuid())
  tenant_id   String
  action_type String  @db.VarChar(100)
  details     String? @db.LongText
  ip_address  String? @db.VarChar(50)
  user_agent  String? @db.LongText

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([tenant_id])
  @@index([action_type])
  @@index([created_at])
}

model SecurityIncident {
  id                String  @id @default(cuid())
  tenant_id         String
  attacker_ip       String  @db.VarChar(50)
  malicious_payload String? @db.LongText
  severity          String  @default("low") // low, medium, high, critical
  incident_type     String  @db.VarChar(100)

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([tenant_id])
  @@index([severity])
  @@index([created_at])
}

// ============================================================
// PRODUCT IMAGES (FIXED - MINIMAL)
// ============================================================

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  url          String  @db.LongText
  altText      String?
  isPrimary    Boolean @default(false)
  thumbUrl     String? @db.LongText // ADD THIS
  caption      String? @db.LongText // ADD THIS
  displayOrder Int     @default(0) // ADD THIS

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt // ADD THIS

  @@index([productId])
  @@index([isPrimary])
}

model ProductSEO {
  id        String  @id @default(cuid())
  productId String  @unique
  meta_title       String?
  meta_description String?  @db.Text
  keywords         String?
  description        String?  @db.Text
  long_tail_keywords           Json?  
  alt_text  String?  @db.Text  
  structured_data    Json?
  optimized_titles   Json?
  ai_generated       Boolean  @default(false)
  generated_at       DateTime @default(now())
  product   Product @relation(fields: [productId], references: [id])
}
model WebsiteStatus {
  id                  String   @id @default(cuid())
  tenant_id           String   @unique
  is_online           Boolean  @default(true)
  manual_status       String   @default("enabled") 
  maintenance_message String?  @db.Text
  updated_at          DateTime @updatedAt
}

model WebsiteControlLog {
  id           String   @id @default(cuid())
  tenant_id    String
  action       String   
  reason       String?  @db.Text
  performed_by String
  created_at   DateTime @default(now())
}

model AdminActivity {
  id          String   @id @default(cuid())
  admin_id    String
  action      String
  description String?  @db.Text
  tenant_id   String?
  created_at  DateTime @default(now())
}
