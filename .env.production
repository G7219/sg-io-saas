NODE_ENV=production
PORT=3000

DATABASE_URL="mysql://sg_io_user:${DB_PASSWORD}@sg-mysql:3306/sg_io"
REDIS_URL=redis://sg-redis:6379

JWT_SECRET=${JWT_SECRET_KEY}
JWT_REFRESH_SECRET=${JWT_REFRESH_KEY}

GEMINI_API_KEY=${GEMINI_KEY}
STRIPE_SECRET_KEY=${STRIPE_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK}
FLUTTERWAVE_SECRET_KEY=${FLUTTERWAVE_KEY}

PRIMARY_DOMAIN=sg.io
ALLOWED_ORIGINS=https://sg.io,https://www.sg.io,https://*.sg.io

ENABLE_MOBILE_MONEY=true
ENABLE_CARD_PAYMENTS=true
ENABLE_CRYPTO=false

LOG_LEVEL=info
SENTRY_DSN=${SENTRY_DSN}